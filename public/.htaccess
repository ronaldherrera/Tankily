# Hostinger (Apache): página 404 del export estático de Next
ErrorDocument 404 /404.html

# Manifiesto de la app instalable con su tipo correcto (Apache lo servía como text/plain)
AddType application/manifest+json .webmanifest

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Páginas de tanques, hilos y anuncios que aún no existen (creados después de la última publicación,
  # con el título cambiado o en otro idioma): a la versión con ?id=, que funciona siempre
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(es|en|de|pt|fr|it|nl|pl)/(tanque|foro/hilo|mercado/anuncio)/[^/]*-([0-9]+)/?$ /$1/$2/?id=$3 [R=302,L]
  # URLs antiguas sin idioma (p. ej. /foro/) → versión en español
  RewriteCond %{REQUEST_URI} !^/(es|en|de|pt|fr|it|nl|pl)(/|$)
  RewriteCond %{REQUEST_URI} !^/(_next|__next|wiki-media|images|favicon\.ico|ads\.txt|404|index\.(html|txt))
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.+)$ /es/$1 [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  # Recursos de Next con hash en el nombre: caché permanente
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Imágenes sin hash (WikiTank): una semana
  <FilesMatch "\.(webp|png|jpg|svg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  # El service worker y su página sin conexión no se guardan en caché: si cambian, se tiene que notar
  <FilesMatch "^(sw\.js|offline\.html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
