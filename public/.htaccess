# Hostinger (Apache): página 404 del export estático de Next
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # URLs antiguas sin idioma (p. ej. /foro/) → versión en español
  RewriteCond %{REQUEST_URI} !^/(es|en|de|pt|fr|it|nl|pl)(/|$)
  RewriteCond %{REQUEST_URI} !^/(_next|__next|wiki-media|images|favicon\.ico|ads\.txt|404|index\.(html|txt))
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.+)$ /es/$1 [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  # Recursos de Next con hash en el nombre: caché permanente
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Imágenes sin hash (WikiTank): una semana
  <FilesMatch "\.(webp|png|jpg|svg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  # El service worker y su página sin conexión no se guardan en caché: si cambian, se tiene que notar
  <FilesMatch "^(sw\.js|offline\.html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
