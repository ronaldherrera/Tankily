/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# AI & Agent artifacts
.gemini/
AGENTS.md
CLAUDE.md
brain/
implementation_plan.md
task.md
walkthrough.md
public/ads.txt

# (la caché de scripts/especies está ahora en node_modules/.cache)
scripts/especies/cache/

# Borradores locales que no se publican
/public/propuestas-logo.html
/scripts/tmp/

# Claves privadas (Apple Sign in, etc.): nunca al repositorio
*.p8
/public/vista-logo-animado.html
/public/vista-ola-fotogramas.svg

# Piezas de redes generadas (scripts/redes/generar.mjs): vídeos e imágenes pesados, se regeneran
marca/redes/salida/
marca/redes/salida-v2/
marca/redes/publicaciones/
# Vídeos de Wikimedia Commons para los ganchos (se vuelven a descargar desde creditos.json)
marca/redes/videos/*.webm
